@page "/kontakt"
@model DmWebsite.Pages.ContactModel
@{
    ViewData["Title"] = "Kontakt";
    var heroImage = Url.Content("~/inc/img/DSC_6251.jpg.jpeg");
}

@section Header {
    <partial name="Shared/_HeaderMainPage" />
}

@* Tylko hero — formularz jest w _Layout po @RenderBody() *@
<div class="bg-[#f3f3f5]">
    <section class="relative bg-[#f3f3f5] overflow-visible" aria-labelledby="contact-page-heading">
        <div class="flex flex-col lg:block">
            <div class="relative lg:absolute lg:top-0 lg:right-0 lg:left-auto w-full lg:w-[48vw] xl:w-[52vw] min-h-[167px] lg:min-h-[460px] xl:min-h-[500px] rounded-l-[40px] overflow-hidden bg-cover bg-center z-[2] lg:-mb-[40px] order-1 lg:order-none"
                 style="background-image: url('@heroImage');"
                 aria-hidden="true">
            </div>

            <div class="relative z-[3] order-2 lg:order-none">
                <div class="max-w-[1680px] mx-auto px-4 lg:px-0">
                    <div class="flex flex-col lg:flex-row lg:min-h-[460px] xl:min-h-[500px]">
                        <div class="flex flex-col justify-center items-center lg:w-[42%] xl:w-[40%] py-8 lg:py-16 lg:pl-4 xl:pl-[130px] lg:pr-6">
                            <h1 id="contact-page-heading" class="font-barlow font-semibold text-[#151515] text-[28px] md:text-[55px] xl:text-[72px] leading-[1.1] text-center w-full">
                                Kontakt
                            </h1>

                            <div class="flex flex-col gap-2 mt-6 w-full lg:hidden">
                                <a href="#kontakt-zmiany-lokatorskie"
                                   class="block w-full text-center font-inter text-[18px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 hover:opacity-90 transition-opacity">
                                    Zmiany lokatorskie
                                </a>
                                <a href="/dopasuj-przestrzen-pod-siebie"
                                   class="block w-full text-center font-inter text-[18px] leading-tight text-[#151515] bg-[#f3f3f5] border border-[#c2c0c9] rounded-lg py-4 px-6 hover:opacity-90 transition-opacity">
                                    Wykończenie wnętrza pod klucz
                                </a>
                            </div>
                        </div>

                        <div class="hidden lg:block lg:flex-1 shrink-0 pointer-events-none" aria-hidden="true"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@* Renderowane w _Layout ZA formularzem kontaktowym *@
@section AfterContact {
    <partial name="Shared/_ContactDepartmentsSection" />
}
