                        </svg>
                    </span>
                    <span>Zmiany lokatorskie na etapie budowy</span>
                </h2>
            </div>

            @* Desktop / tablet *@
            <div class="hidden sm:grid sm:grid-cols-2 sm:gap-8 lg:gap-12 pb-8 lg:pb-12">
                <div class="flex items-start">
                    <h3 class="font-barlow font-semibold text-[#151515] text-[24px] md:text-[36px] leading-[1.2] m-0">
                        Oto 5 kroków do wprowadzenia zmian lokatorskich
                    </h3>
                </div>

                <div class="min-w-0">
                    <p class="font-inter text-[16px] text-[#595355] m-0">[smartslider3 slider="6"]</p>
                </div>
            </div>

            @* Mobile *@
            <div class="sm:hidden pb-8">
                <h3 class="font-barlow font-semibold text-[#151515] text-[24px] leading-[1.2] mb-6">
                    Oto 5 kroków do wprowadzenia zmian lokatorskich
                </h3>

                <p class="font-inter text-[16px] text-[#595355] m-0">[smartslider3 slider="8"]</p>
            </div>

            <div class="pb-10 lg:pb-16">
                <a href="@applicationPdf"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="inline-flex items-center justify-center font-inter text-[16px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-8 border border-[#c2c0c9] hover:opacity-90 transition-opacity">
                    Pobierz wniosek
                </a>
            </div>
        </div>
    </section>

    @* Mieszkanie pod klucz *@
    <section id="mieszkanie-pod-klucz" class="scroll-mt-24 bg-[#f3f3f5]" aria-labelledby="turn-key-heading-mobile">
        @* Nagłówek mobile *@
        <div class="lg:hidden max-w-[1680px] mx-auto px-4 py-8">
            <h2 id="turn-key-heading-mobile" class="font-barlow font-semibold text-[#151515] text-[28px] leading-[1.15] flex items-center gap-4">
                <span class="inline-flex shrink-0 w-12 h-12 items-center justify-center rounded-full bg-[#ba9e60] text-white" aria-hidden="true">
                    <svg class="w-5 h-5" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
