@page "/dopasuj-przestrzen-pod-siebie"
@model DmWebsite.Pages.CustomizeSpaceModel
@{
    ViewData["Title"] = "Dopasuj przestrzeń pod siebie";
    var heroImage = Url.Content("~/inc/img/Depositphotos_223168402_L.jpg");
    var applicationPdf = Url.Content("~/inc/docs/WNIOSEK-O-WPROWADZENIE-ZMIAN-LOKATORSKICH-.pdf");

    var turnKeyBenefits = new[]
    {
        new
        {
            Icon = "Icon.png",
            Title = "Oszczędność czasu",
            Lead = "Dzięki takiej usłudze zaoszczędzisz czas i unikniesz stresu związanego z samodzielnym wykończeniem.",
            Text = "Profesjonalne wykończenie zapewnia, że mieszkanie będzie gotowe do zamieszkania od razu, a także pozwala na dostosowanie wnętrza do własnych potrzeb i gustu."
        },
        new
        {
            Icon = "Icon-1.png",
            Title = "Oszczędność pieniędzy",
            Lead = "Współpracując z nami, zapłacisz mniej niż zatrudniając osobną firmę, ponieważ mamy bezkonkurencyjne ceny na materiał czy podwykonawców.",
            Text = "Zaoszczędzone pieniądze możesz zainwestować np. w lepszej jakości materiały niż standardowe lub np. wymarzone łóżko."
        },
        new
        {
            Icon = "Icon-2.png",
            Title = "Pewny komfort",
            Lead = "Usługa wykończenia mieszkania pod klucz to idealne rozwiązanie dla osób, które chcą uniknąć skomplikowanych procesów związanych z aranżacją wnętrz.",
            Text = "Dzięki niej możesz cieszyć się nowym mieszkaniem bez zbędnych zmartwień, a także mieć pewność, że wszystko zostało wykonane zgodnie z najwyższymi standardami."
        },
        new
        {
            Icon = "Icon-3.png",
            Title = "Uproszczenie procesu",
            Lead = "Usługa wykończenia mieszkania jest idealna dla osób, które nie lubią szukać nowych wykonawców i chcą skrócić ilość powiązań.",
            Text = "Korzystając z naszych usług, nie musisz szukać nowych podwykonawców i martwić się o odpowiedzialność wykonanej pracy. Z nami masz wszystko w jednym miejscu."
        }
    };

    var turnKeyApartmentTypesCol1 = new[]
    {
        new { Label = "Kawalerki", Sublabel = "" },
        new { Label = "Mieszkania", Sublabel = "3-pokojowe" },
        new { Label = "Mieszkania", Sublabel = "dwupoziomowe" }
    };

    var turnKeyApartmentTypesCol2 = new[]
    {
        new { Label = "Mieszkania", Sublabel = "2-pokojowe" },
        new { Label = "Mieszkania", Sublabel = "4-pokojowe" },
        new { Label = "Domy", Sublabel = "wolnostojące" }
    };

    var turnKeyTypesBg = Url.Content("~/inc/img/Big-Image-Section.png");

    var cooperationStages = new[]
    {
        new
        {
            NumberBg = "1-2.png",
            Icon = "Frame-2.png",
            Title = "Konsultacia i ustalenie potrzeb oraz zakresu pracy",
            TitleLine2 = "",
            Text = "Każda udana realizacja zaczyna się od rozmowy. Na tym etapie skupiamy się przede wszystkim na poznaniu Twoich oczekiwań, stylu życia oraz wizji przestrzeni, którą chcesz stworzyć. Analizujemy potrzeby funkcjonalne, estetyczne oraz budżetowe, aby jak najlepiej dopasować zakres prac do Twoich możliwości i planów. To moment, w którym możesz swobodnie opowiedzieć o swoich inspiracjach, pomysłach i priorytetach. My z kolei doradzamy, podpowiadamy rozwiązania i wskazujemy najlepsze kierunki działania. Dzięki temu już na początku budujemy jasny plan współpracy, który pozwala uniknąć niepotrzebnych niespodzianek na kolejnych etapach realizacji."
        },
        new
        {
            NumberBg = "2-1.png",
            Icon = "Image-19.png",
            Title = "Prace projektowe",
            TitleLine2 = "i wybór materiałów",
            Text = "Po ustaleniu wszystkich założeń przechodzimy do etapu projektowego, gdzie pomysły zaczynają przybierać realny kształt. Przygotowujemy koncepcję przestrzeni, dopracowujemy detale oraz dobieramy materiały, które nie tylko będą świetnie wyglądać, ale również sprawdzą się w codziennym użytkowaniu. To moment, w którym wspólnie wybieramy kolory, faktury, elementy wykończenia i rozwiązania techniczne. Dbamy o to, aby całość była spójna, funkcjonalna i ponadczasowa. Naszym celem jest stworzenie projektu, który będzie nie tylko estetyczny, ale przede wszystkim dopasowany do Twoich potrzeb i stylu życia."
        },
        new
        {
            NumberBg = "3-1.png",
            Icon = "Image-20.png",
            Title = "Prace wykończeniowe",
            TitleLine2 = "i odbiór kluczy",
            Text = "Gdy projekt jest dopracowany w każdym detalu, rozpoczyna się etap realizacji. To właśnie wtedy wizja zmienia się w rzeczywistość. Koordynujemy wszystkie prace wykończeniowe, dbamy o jakość wykonania oraz pilnujemy, aby każdy element został zrealizowany zgodnie z projektem. Na bieżąco monitorujemy postęp prac i rozwiązujemy ewentualne wyzwania, tak aby cały proces przebiegał sprawnie i bez stresu dla Ciebie. Finałem jest moment odbioru – chwila, w której możesz zobaczyć gotową przestrzeń i odebrać klucze do miejsca, które zostało stworzone dokładnie z myślą o Tobie."
        }
    };

    var vimeoBackgroundVideoUrl = "https://player.vimeo.com/video/1174678417?background=1&autoplay=1&muted=1&loop=1";
    var partnerImage = Url.Content("~/inc/img/Image-10.png");
    var partnerIcon = Url.Content("~/inc/img/Icon-Box-2.png");
}

@section Header {
    <partial name="Shared/_HeaderMainPage" />
}

<main class="bg-[#f3f3f5]">
    <section class="relative bg-[#f3f3f5] overflow-visible" aria-labelledby="customize-space-heading">
        <div class="flex flex-col lg:block">
            <div class="relative lg:absolute lg:top-0 lg:right-0 lg:left-auto w-full lg:w-[48vw] xl:w-[52vw] min-h-[167px] lg:min-h-[460px] xl:min-h-[500px] rounded-l-[40px] overflow-hidden bg-cover bg-center z-[2] lg:-mb-[40px] order-1 lg:order-none"
                 style="background-image: url('@heroImage');"
                 aria-hidden="true">
            </div>

            <div class="relative z-[3] order-2 lg:order-none">
                <div class="max-w-[1680px] mx-auto px-4 lg:px-0">
                    <div class="flex flex-col lg:flex-row lg:min-h-[460px] xl:min-h-[500px]">
                        <div class="flex flex-col justify-center items-center lg:w-[42%] xl:w-[40%] py-8 lg:py-16 lg:pl-4 xl:pl-[130px] lg:pr-6">
                            <h1 id="customize-space-heading" class="font-barlow font-semibold text-[#151515] text-[28px] md:text-[55px] xl:text-[72px] leading-[1.1] text-center w-full">
                                Dopasuj przestrzeń pod siebie
                            </h1>

                            @* Desktop / tablet: przyciski w linii *@
                            <div class="hidden lg:flex flex-wrap gap-3 mt-8 justify-center w-full">
                                <a href="#zmiany-lokatorskie"
                                   class="inline-flex items-center justify-center font-inter text-[16px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 border border-[#c2c0c9] hover:opacity-90 transition-opacity">
                                    Zmiany lokatorskie
                                </a>
                                <a href="#mieszkanie-pod-klucz"
                                   class="hidden xl:inline-flex items-center justify-center font-inter text-[16px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 border border-[#c2c0c9] hover:opacity-90 transition-opacity">
                                    Wykończenie wnętrza pod klucz
                                </a>
                                <a href="#mieszkanie-pod-klucz"
                                   class="inline-flex xl:hidden items-center justify-center font-inter text-[16px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 border border-[#c2c0c9] hover:opacity-90 transition-opacity">
                                    Wykończenie wnętrza
                                </a>
                            </div>

                            @* Mobile: przyciski pełnej szerokości *@
                            <div class="flex lg:hidden flex-col gap-2 mt-6 w-full">
                                <a href="#zmiany-lokatorskie"
                                   class="block w-full text-center font-inter text-[18px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 hover:opacity-90 transition-opacity">
                                    Zmiany lokatorskie
                                </a>
                                <a href="#mieszkanie-pod-klucz"
                                   class="block w-full text-center font-inter text-[18px] leading-tight text-[#efeef3] bg-[#151515] rounded-lg py-4 px-6 hover:opacity-90 transition-opacity">
                                    Wykończenie pod klucz
                                </a>
                            </div>
                        </div>

                        <div class="hidden lg:block lg:flex-1 shrink-0 pointer-events-none" aria-hidden="true"></div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Zmiany lokatorskie *@
    <section id="zmiany-lokatorskie" class="scroll-mt-24 bg-[#f3f3f5]" aria-labelledby="tenant-changes-heading">
        <div class="max-w-[1680px] mx-auto px-4 lg:px-8 xl:px-[130px]">
            <div class="py-8 lg:py-12">
                <h2 id="tenant-changes-heading" class="font-barlow font-semibold text-[#151515] text-[28px] md:text-[42px] xl:text-[55px] leading-[1.15] flex items-center gap-4">
                    <span class="inline-flex shrink-0 w-12 h-12 md:w-14 md:h-14 items-center justify-center rounded-full bg-[#ba9e60] text-white" aria-hidden="true">
                        <svg class="w-5 h-5 md:w-6 md:h-6" viewBox="0 0 32 32" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
