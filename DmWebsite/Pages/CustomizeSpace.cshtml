                    </svg>
                </span>
                <span>Mieszkanie pod klucz</span>
            </h2>
        </div>

        <div class="max-w-[1680px] mx-auto px-4 sm:px-5 lg:px-6 xl:px-8 pb-10 lg:pb-16">
            <h3 class="font-barlow font-semibold text-[#151515] text-[24px] md:text-[36px] leading-[1.2] mb-8 lg:mb-12 text-center">
                Mieszkanie pod klucz – jakie są plusy?
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-5 lg:gap-6 xl:gap-7">
                @foreach (var benefit in turnKeyBenefits)
                {
                    var iconUrl = Url.Content($"~/inc/img/{benefit.Icon}");
                    <article class="flex flex-col h-full min-h-[240px] lg:min-h-[280px] bg-white rounded-[24px] p-6 lg:p-8 xl:p-9">
                        <img src="@iconUrl"
                             alt=""
                             width="88"
                             height="88"
                             class="w-[88px] h-[88px] lg:w-[100px] lg:h-[100px] object-contain"
                             loading="lazy" />
                        <h4 class="font-barlow font-semibold text-[20px] lg:text-[24px] leading-[1.3] text-[#151515] mt-6 lg:mt-7 mb-4 m-0">
                            @benefit.Title
                        </h4>
                        <p class="font-inter text-[14px] lg:text-[16px] leading-[1.5] text-[#151515] m-0 mb-3">
                            @benefit.Lead
                        </p>
                        <p class="font-inter text-[14px] lg:text-[16px] leading-[1.5] text-[#595355] m-0 mt-auto">
                            @benefit.Text
                        </p>
                    </article>
                }
            </div>
        </div>
    </section>

    @* Jakie typy mieszkań przygotowujemy pod klucz? *@
    <section class="relative bg-cover bg-center bg-no-repeat py-12 lg:py-0 lg:min-h-[640px] flex items-center"
             style="background-image: url('@turnKeyTypesBg');"
             aria-labelledby="turn-key-types-heading">
        <div class="relative z-[1] w-full max-w-[1390px] mx-auto px-4 lg:px-4">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 xl:gap-16 items-center">
                <div class="flex items-center lg:min-h-[640px]">
                    <h2 id="turn-key-types-heading" class="font-barlow font-semibold text-white text-[28px] md:text-[36px] lg:text-[44px] leading-[1.2] m-0">
                        Jakie typy mieszkań przygotowujemy pod klucz?
                    </h2>
                </div>

                <div class="flex items-center justify-center lg:min-h-[640px] lg:py-10">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 lg:gap-x-12 gap-y-5 lg:gap-y-7 w-full max-w-[640px] lg:max-w-none">
                    @foreach (var typesColumn in new[] { turnKeyApartmentTypesCol1, turnKeyApartmentTypesCol2 })
                    {
                        <div class="flex flex-col gap-5 lg:gap-7">
                            @foreach (var item in typesColumn)
                            {
                                <div class="flex items-start gap-3 lg:gap-4">
                                    <span class="inline-flex shrink-0 w-8 h-8 lg:w-12 lg:h-12 text-[#ba9e60] mt-1 lg:mt-0" aria-hidden="true">
                                        <svg class="w-full h-full" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                                            <polyline points="22 4 12 14.01 9 11.01"/>
                                        </svg>
                                    </span>
                                    <p class="font-barlow font-semibold text-[#efeef3] text-[28px] lg:text-[36px] leading-[1.2] m-0">
                                        @if (string.IsNullOrEmpty(item.Sublabel))
                                        {
                                            @item.Label
                                        }
                                        else
                                        {
                                            @item.Label<br>@item.Sublabel
                                        }
                                    </p>
                                </div>
                            }
                        </div>
                    }
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* Etapy współpracy *@
    <section class="bg-[#f3f3f5]" aria-labelledby="cooperation-stages-heading">
        <div class="max-w-[1400px] mx-auto px-4 py-8 lg:py-20">
            <h2 id="cooperation-stages-heading" class="font-barlow font-semibold text-[#151515] text-[28px] lg:text-[36px] leading-[1.2] text-center m-0 mb-6 lg:mb-16">
                Etapy współpracy
            </h2>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-8">
                @foreach (var stage in cooperationStages)
                {
                    var numberBgUrl = Url.Content($"~/inc/img/{stage.NumberBg}");
                    var iconUrl = Url.Content($"~/inc/img/{stage.Icon}");
                    <article class="relative flex flex-col items-center text-center gap-4 lg:gap-6 bg-no-repeat bg-auto bg-[position:15px_35%] px-2 pb-2"
                             style="background-image: url('@numberBgUrl');">
                        <img src="@iconUrl"
                             alt=""
                             width="120"
                             height="120"
                             class="w-20 h-20 lg:w-[120px] lg:h-[120px] object-contain"
                             loading="lazy" />
                        <h3 class="font-barlow font-bold text-[#151515] text-[20px] lg:text-[24px] leading-[1.2] m-0">
                            @if (string.IsNullOrEmpty(stage.TitleLine2))
                            {
                                @stage.Title
                            }
                            else
                            {
                                @stage.Title<br>@stage.TitleLine2
                            }
                        </h3>
                        <p class="font-inter text-[14px] lg:text-[16px] leading-[1.5] text-[#787878] m-0">
                            @stage.Text
                        </p>
                    </article>
                }
            </div>
        </div>
    </section>

    @* Film Vimeo w tle *@
    <section class="relative w-full h-[300px] md:h-[500px] overflow-hidden" aria-hidden="true">
        <iframe src="@vimeoBackgroundVideoUrl"
                class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[100vw] h-[56.25vw] min-w-[177.78vh] min-h-[100vh] border-0 pointer-events-none"
                allow="autoplay; fullscreen; picture-in-picture"
                title="video"></iframe>
    </section>

    @* Partner NA.GOTOWO — desktop *@
    <section class="hidden lg:block bg-[#f3f3f5] border-b border-[#c2c0c9]" aria-labelledby="partner-heading-desktop">
        <div class="max-w-[1680px] mx-auto px-4 pt-[60px] pb-[100px]">
            <div class="grid grid-cols-2 gap-8 xl:gap-12 items-center">
                <figure class="m-0">
                    <img src="@partnerImage"
                         alt=""
                         width="828"
                         height="621"
                         class="w-full h-auto"
                         loading="lazy" />
                </figure>

                <div class="flex flex-col gap-6">
                    <h2 id="partner-heading-desktop" class="font-barlow font-semibold text-[#151515] text-[36px] xl:text-[44px] leading-[1.2] m-0 max-w-[680px]">
                        Poznaj naszego partnera remontowego firmę NA.GOTOWO
                    </h2>
                    <p class="font-inter text-[16px] leading-[1.5] text-[#151515] m-0 max-w-[610px]">
                        Realizacja idealnego wnętrza to nie tylko dobry projekt, ale także sprawdzona ekipa, która potrafi zamienić wizję w rzeczywistość. Dlatego współpracujemy z naszym zaufanym partnerem – Na Gotowo, firmą specjalizującą się w kompleksowych pracach wykończeniowych. Dzięki wieloletniemu doświadczeniu, precyzji wykonania oraz dbałości o każdy detal, realizacje przebiegają sprawnie, profesjonalnie i zgodnie z najwyższymi standardami.
                    </p>
                    <p class="font-inter text-[16px] leading-[1.5] text-[#595355] m-0 max-w-[690px]">
                        Na Gotowo to zespół fachowców, którzy doskonale rozumieją, jak ważna jest jakość, terminowość oraz dobra komunikacja podczas realizacji projektu. Ich podejście opiera się na rzetelnej pracy, nowoczesnych rozwiązaniach oraz pełnym zaangażowaniu na każdym etapie realizacji. Dzięki temu klienci mogą mieć pewność, że ich przestrzeń zostanie wykończona z największą starannością i zgodnie z założeniami projektu. Współpraca z zaufanym partnerem pozwala nam zapewnić spójność całego procesu – od pierwszej koncepcji, przez projekt, aż po finalne wykończenie wnętrza. Dzięki temu nasi klienci otrzymują kompleksową usługę, w której każdy etap jest dopracowany, a efekt końcowy spełnia najwyższe oczekiwania.
                    </p>
                </div>
            </div>
        </div>
    </section>

    @* Partner NA.GOTOWO — mobile *@
    <section class="lg:hidden bg-[#f3f3f5]" aria-labelledby="partner-heading-mobile">
        <div class="max-w-[1680px] mx-auto px-4 py-[60px]">
            <div class="flex items-center gap-4 mb-8">
                <hr class="flex-1 border-0 border-t border-[#c2c0c9] m-0" />
                <img src="@partnerIcon"
                     alt=""
                     width="72"
                     height="72"
                     class="w-[72px] h-[72px] object-contain shrink-0"
                     loading="lazy" />
                <hr class="flex-1 border-0 border-t border-[#c2c0c9] m-0" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 items-start">
                <div class="flex flex-col gap-4">
                    <h2 id="partner-heading-mobile" class="font-barlow font-semibold text-[#151515] text-[28px] leading-[1.2] m-0 pt-3.5">
                        Kupujesz u nas mieszkanie i potrzebujesz wykończenia pod klucz?
                    </h2>
                    <p class="font-inter text-[16px] leading-[1.5] text-[#151515] m-0 pb-6 max-w-[610px]">
                        Skorzystaj z naszej usługi wykończenia pod klucz realizowanej z partnerem NA.GOTOWO, który od lat należy do najlepszych specjalistów w branży.
                    </p>
                    <figure class="m-0">
                        <img src="@partnerImage"
                             alt=""
                             width="828"
                             height="621"
                             class="w-full h-auto"
                             loading="lazy" />
                    </figure>
                </div>

                <p class="font-inter text-[14px] sm:text-[16px] leading-[1.5] text-[#595355] m-0 max-w-[690px]">
                    Dzięki temu odbierzesz mieszkanie w pełni przygotowane do zamieszkania, bez stresu i nadzorowania ekip. Oferujemy <strong class="font-semibold text-[#151515]">trzy pakiety wykończenia</strong>, dopasowane do różnych potrzeb i budżetów: Standard, Komfort i Premium. Każdy z nich obejmuje kompleksowe prace, wysokiej jakości materiały i możliwość personalizacji. Niezależnie od oczekiwań – każdy znajdzie coś dla siebie i może wprowadzić się do gotowego, perfekcyjnie wykończonego wnętrza.
                </p>
            </div>
        </div>
    </section>
</main>
