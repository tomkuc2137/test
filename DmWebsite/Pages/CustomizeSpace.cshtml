                    </svg>
                </span>
                <span>Mieszkanie pod klucz</span>
            </h2>
        </div>

        @* Nagłówek desktop *@
        <div class="hidden lg:block max-w-[1680px] mx-auto px-4 lg:px-8 xl:px-[130px] py-8 lg:py-12">
            <h2 id="turn-key-heading-desktop" class="font-barlow font-semibold text-[#151515] text-[28px] md:text-[42px] xl:text-[55px] leading-[1.15] flex items-center gap-4">
                <span class="inline-flex shrink-0 w-12 h-12 md:w-14 md:h-14 items-center justify-center rounded-full bg-[#ba9e60] text-white" aria-hidden="true">
