@* Sekcja: Dlaczego warto porozmawiać z ekspertem od kredytów? *@

<section class="bg-white" aria-labelledby="financing-why-heading">
    <div class="max-w-[1680px] mx-auto px-4 lg:px-8 xl:px-12 py-10 lg:py-20">
        <h2 id="financing-why-heading" class="font-barlow font-semibold text-center text-[28px] lg:text-[36px] leading-[1.2] text-[#151515] mb-8 lg:mb-12">
