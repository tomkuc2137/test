                            </svg>
                            726 260 322
                        </a>
                    </div>
                </div>

                @* Prawa kolumna: formularz (~2/3) *@
                <div class="px-5 py-8 lg:px-10 lg:py-12 xl:px-12 xl:pl-12 border-t lg:border-t-0 border-[#c2c0c9]">
                    <p class="font-inter text-[16px] lg:text-[18px] leading-[1.5] text-[#151515] mb-3 m-0">
                        Wypełnij dane odnośnie swojego kredytu, a Damian oddzwoni do&nbsp;Ciebie i&nbsp;przedstawi wstępne informacje
                    </p>
                    <p class="font-inter text-[14px] lg:text-[16px] leading-[1.5] text-[#595355] mb-6 m-0">
                        Jest to forma kalkulatora kredytowego z tym, że w naszym wypadku nie dostajesz suchych informacji, ale również poradę ekspercką.
                    </p>

                    <form id="financing-contact-form" class="space-y-5" action="/send-contact" method="post" novalidate>
                        <input type="hidden" name="formType" value="financing" />

                        <div class="bg-[#efeef3] rounded-lg px-5 py-5 space-y-5">
                            <div>
                                <label for="financing-loan-amount" class="block text-[14px] font-medium text-[#151515] mb-2">
                                    Szacowana kwota kredytu [zł] <span class="text-[#ba9e60]">*</span>
                                </label>
                                <input type="number"
                                       id="financing-loan-amount"
                                       name="loanAmount"
                                       required
                                       min="1"
                                       step="1"
                                       placeholder="np. 300000"
                                       class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                            </div>

                            <div>
                                <label for="financing-down-payment" class="block text-[14px] font-medium text-[#151515] mb-2">
                                    Szacowany wkład własny [zł] <span class="text-[#ba9e60]">*</span>
                                </label>
                                <input type="number"
                                       id="financing-down-payment"
                                       name="downPayment"
                                       required
                                       min="0"
                                       step="1"
                                       placeholder="np. 300000"
                                       class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                            </div>

                            <div>
                                <label for="financing-loan-term" class="block text-[14px] font-medium text-[#151515] mb-2">
                                    Czas trwania kredytu [msc] <span class="text-[#ba9e60]">*</span>
                                </label>
                                <input type="number"
                                       id="financing-loan-term"
                                       name="loanTermMonths"
                                       required
                                       min="1"
                                       step="1"
                                       placeholder="np. 24"
                                       class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                            </div>
                        </div>

                        <div>
                            <label for="financing-name" class="block text-[14px] font-medium text-[#151515] mb-2">
                                Podaj imię <span class="text-[#ba9e60]">*</span>
                            </label>
                            <input type="text"
                                   id="financing-name"
                                   name="name"
                                   required
                                   autocomplete="name"
                                   placeholder="np. Kamil"
                                   class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                        </div>

                        <div>
                            <label for="financing-email" class="block text-[14px] font-medium text-[#151515] mb-2">
                                Podaj e-mail do kontaktu <span class="text-[#ba9e60]">*</span>
                            </label>
                            <input type="email"
                                   id="financing-email"
                                   name="email"
                                   required
                                   autocomplete="email"
                                   placeholder="np. Kamil@gmail.com..."
                                   class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                        </div>

                        <div>
                            <label for="financing-phone" class="block text-[14px] font-medium text-[#151515] mb-2">
                                Podaj telefon do kontaktu (opcjonalnie)
                            </label>
                            <input type="tel"
                                   id="financing-phone"
                                   name="phone"
                                   autocomplete="tel"
                                   placeholder=""
                                   class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                        </div>

                        <div class="flex items-start gap-3">
                            <input type="checkbox"
                                   id="financing-consent"
                                   name="consent"
                                   required
                                   value="true"
                                   class="mt-1 h-4 w-4 shrink-0 rounded border-[#c2c0c9] text-[#151515] focus:ring-[#ba9e60]/40" />
                            <label for="financing-consent" class="text-[14px] leading-[1.6] text-[#595355]">
                                Wyrażam zgodę na przetwarzanie moich danych osobowych zgodnie z
                                <a href="/polityka-prywatnosci" class="text-[#151515] underline hover:text-[#ba9e60] transition-colors">Polityką Prywatności</a>.
                            </label>
                        </div>

                        <p id="financing-contact-form-status" class="hidden text-[14px]" role="alert" aria-live="polite"></p>

                        <button type="submit"
                                class="w-full inline-flex items-center justify-center rounded-lg bg-[#151515] text-[#efeef3] font-inter text-[16px] px-8 py-[19px] border border-[#c2c0c9] hover:opacity-90 transition-opacity disabled:opacity-60">
                            Poproś o poradę
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
