@{
    var contactEmail = "biuro@formadevelopment.pl";
    var contactPhone = "881 269 000";
    var contactPhoneHref = "tel:+48881269000";
    var privacyPolicyUrl = "/polityka-prywatnosci/";
}

@* Kontakt / formularz *@
<section class="bg-[#f3f3f5] border-t border-[#c2c0c9] rounded-b-[40px] overflow-hidden" aria-labelledby="contact-heading">
    <div class="max-w-[1680px] mx-auto px-4 lg:px-[142px] py-8 lg:py-20">
        <h2 id="contact-heading" class="font-barlow font-semibold text-[#151515] text-[28px] lg:text-[42px] leading-[1.2] text-left lg:text-center m-0">
            Masz pytania dot. mieszkania lub potrzebujesz pomocy w wyborze?
        </h2>
        <p class="font-inter text-[20px] lg:text-[32px] leading-[1.4] text-[#151515] text-left lg:text-center m-0 mt-2">
            Napisz do nas wiadomość lub zadzwoń. Chętnie pomożemy!
        </p>

        <div class="mt-6 lg:mt-16 bg-white rounded-[24px] overflow-hidden">
            <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-stretch">
                <div class="flex flex-col items-center justify-center text-center p-4 pt-4 lg:p-10 lg:border-r lg:border-[#e4e0f2]">
                    <div class="inline-flex items-center justify-center w-10 h-10 lg:w-20 lg:h-20 rounded-full bg-[#efeef3] text-[#ba9e60] shrink-0" aria-hidden="true">
