@* Sekcja kontaktowa: dane firmy, mapa, formularz *@

<section class="bg-[#f3f3f5]" aria-labelledby="contact-form-heading">
    <div class="max-w-[1680px] mx-auto px-4 pt-8 md:pt-[120px] pb-8 md:pb-10">
        <div class="grid grid-cols-1 lg:grid-cols-[42%_58%] gap-8 lg:gap-10 xl:gap-12">
            @* Lewa kolumna: logo, adres, kontakt, mapa *@
            <div class="flex flex-col gap-10">
                <img src="@Url.Content("~/inc/img/forma-dev-logo.svg")"
                     alt="Forma Development"
                     width="210"
                     height="48"
                     class="w-full max-w-[210px] h-auto" />

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-8">
                    <p class="text-[14px] md:text-[16px] lg:text-[18px] leading-[1.5] text-[#595355] m-0">
                        Sienkiewicza 3 lok 7/3<br />
                        15-432 Białystok
                    </p>

                    <ul class="space-y-3 text-[14px] md:text-[16px] text-[#595355]">
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 shrink-0 text-[#ba9e60] mt-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M21 21H3C2.2 21 1.44 20.68.88 20.12.32 19.56 0 18.8 0 18V6c0-.8.32-1.56.88-2.12C1.44 3.32 2.2 3 3 3h18c.8 0 1.56.32 2.12.88.56.56.88 1.32.88 2.12v12c0 .8-.32 1.56-.88 2.12-.56.56-1.32.88-2.12.88ZM3 4.5a1.5 1.5 0 0 0-1.06 2.56L12 13.8l10.06-6.74A1.5 1.5 0 0 0 21 4.5H3Zm0 15.75a1.5 1.5 0 0 0 2.12 0l8.25-8.25a1.5 1.5 0 1 0-2.12-2.12L3 19.5V20.25Zm18 0V19.5l-8.25-8.25a1.5 1.5 0 0 0-2.12 2.12l8.25 8.25a1.5 1.5 0 0 0 2.12 0Z"/>
                            </svg>
                            <a href="mailto:biuro@formadevelopment.pl" class="hover:text-[#151515] transition-colors">
                                biuro@formadevelopment.pl
                            </a>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="w-6 h-6 shrink-0 text-[#ba9e60] mt-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M5.46.52a1.5 1.5 0 0 1 1.74.19l.15.1c.86.67 1.62 1.47 2.24 2.37.62.9 1.09 1.9 1.4 2.95.11.34.1.71-.01 1.05a1.5 1.5 0 0 1-.71.83l-1.64 1.09a.15.15 0 0 0-.07.22l.28.49c.71 1.13 1.6 2.14 2.62 3.02 1.07.89 2.27 1.61 3.57 2.12.08.03.17.03.25 0 .08-.03.15-.08.2-.15l1.26-1.82a1.5 1.5 0 0 1 1.72-.61c1.09.18 2.1.66 2.94 1.37.73.63 1.3 1.42 1.67 2.31.1.32.1.66.01.97-.1.48-.28.94-.49 1.38-1 1.8-2.64 3.14-4.6 3.74a1.5 1.5 0 0 1-.53.08c-.13 0-.25-.01-.38-.05-3.32-1.07-6.37-2.82-8.97-5.12l-.51-.47C4.08 14.19 1.81 10.58.54 6.57a1.5 1.5 0 0 1 .24-1.03C1.14 3.59 2.48 1.94 4.29.97l.28-.16c.28-.12.58-.23.89-.29Z"/>
                            </svg>
                            <a href="tel:881269000" class="hover:text-[#151515] transition-colors">
                                881 269 000
                            </a>
                        </li>
                    </ul>
                </div>

                <div class="rounded-[24px] overflow-hidden min-h-[250px] md:min-h-[320px] lg:min-h-[360px]">
                    <iframe
                        title="Mapa – Sienkiewicza 3, Białystok"
                        src="https://www.google.com/maps?q=Sienkiewicza+3+lok+7%2F3,+15-432+Bia%C5%82ystok&output=embed"
                        class="w-full h-full min-h-[250px] md:min-h-[320px] lg:min-h-[360px] border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade">
                    </iframe>
                </div>
            </div>

            @* Prawa kolumna: formularz *@
            <div class="lg:pl-20 xl:px-[142px] pt-0 md:pt-0 max-md:pt-8 max-md:border-t max-md:border-[#c2c0c9]">
                <h2 id="contact-form-heading" class="font-barlow font-semibold text-[28px] md:text-[36px] leading-[1.2] text-[#151515] mb-4">
                    Porozmawiajmy o&nbsp;Twoim nowym miejscu do&nbsp;życia lub&nbsp;inwestycji
                </h2>
                <p class="font-inter text-[20px] md:text-[25px] xl:text-[32px] leading-[1.4] font-normal text-[#595355] mb-8">
                    Napisz do nas wiadomość. Porozmawiajmy!
                </p>

                <form id="contact-form" class="contact-form space-y-5" action="/send-contact" method="post" novalidate>
                    <div>
                        <label for="contact-name" class="block text-[14px] font-medium text-[#151515] mb-2">
                            Podaj imię <span class="text-[#ba9e60]">*</span>
                        </label>
                        <input type="text"
                               id="contact-name"
                               name="name"
                               required
                               autocomplete="name"
                               placeholder="np. Kamil"
                               class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                    </div>

                    <div>
                        <label for="contact-email" class="block text-[14px] font-medium text-[#151515] mb-2">
                            Podaj e-mail <span class="text-[#ba9e60]">*</span>
                        </label>
                        <input type="email"
                               id="contact-email"
                               name="email"
                               required
                               autocomplete="email"
                               placeholder="np. Kamil@gmail.com..."
                               class="w-full rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40" />
                    </div>

                    <div>
                        <label for="contact-message" class="block text-[14px] font-medium text-[#151515] mb-2">
                            Wiadomość <span class="text-[#ba9e60]">*</span>
                        </label>
                        <textarea id="contact-message"
                                  name="message"
                                  required
                                  rows="6"
                                  placeholder="Treść pytania lub wiadomości..."
                                  class="w-full min-h-[140px] rounded-lg border border-[#c2c0c9] bg-white px-4 py-3 text-[16px] text-[#151515] placeholder:text-[#7c7476] focus:outline-none focus:ring-2 focus:ring-[#ba9e60]/40 resize-y"></textarea>
                    </div>

                    <div class="flex items-start gap-3">
                        <input type="checkbox"
                               id="contact-consent"
                               name="consent"
                               required
                               value="true"
                               class="mt-1 h-4 w-4 shrink-0 rounded border-[#c2c0c9] text-[#151515] focus:ring-[#ba9e60]/40" />
                        <label for="contact-consent" class="text-[14px] leading-[1.6] text-[#595355]">
                            Wyrażam zgodę na przetwarzanie moich danych osobowych zgodnie z
                            <a href="/polityka-prywatnosci" class="text-[#151515] underline hover:text-[#ba9e60] transition-colors">Polityką Prywatności</a>.
                        </label>
                    </div>

                    <p id="contact-form-status" class="hidden text-[14px]" role="alert" aria-live="polite"></p>

                    <button type="submit"
                            class="w-full md:w-auto inline-flex items-center justify-center rounded-lg bg-[#151515] text-[#efeef3] font-inter text-[16px] px-8 py-[19px] border border-[#c2c0c9] hover:opacity-90 transition-opacity disabled:opacity-60">
                        Wyślij wiadomość
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
