@* Sekcja: Często pojawiające się pytania *@
@{
    var faqItems = new[]
    {
        new
        {
            Question = "W jakim czasie dostanę odpowiedź od eksperta?",
            Answer = "Zależy nam na tym, aby każda osoba zainteresowana finansowaniem otrzymała szybką i konkretną pomoc. Zazwyczaj pierwszy kontakt ze strony eksperta następuje w ciągu 24 godzin od momentu wysłania zapytania. Podczas tej rozmowy można wstępnie omówić swoją sytuację finansową, potrzeby oraz możliwości kredytowe. Ekspert odpowie na najważniejsze pytania, wyjaśni cały proces i zaproponuje dalsze kroki. Dzięki temu już na samym początku zyskujesz jasny obraz swojej sytuacji oraz dostępnych opcji finansowania."
        },
        new
        {
            Question = "Ile kosztuje wsparcie eksperta lub ile wynosi marża od kredytu?",
            Answer = "Współpraca z ekspertem kredytowym jest dla klienta bezpłatna. Oznacza to, że nie ponosisz dodatkowych kosztów za analizę Twojej sytuacji finansowej, porównanie ofert banków czy pomoc w przygotowaniu dokumentów. Marża kredytu zależy natomiast od wielu czynników, takich jak wysokość wkładu własnego, zdolność kredytowa, wybrany bank czy aktualna sytuacja na rynku finansowym. Zadaniem eksperta jest znalezienie najkorzystniejszej oferty spośród dostępnych na rynku i przeprowadzenie Cię przez cały proces w możliwie najprostszy sposób."
        },
        new
        {
            Question = "Jaki jest okres oczekiwania na decyzję z banku?",
            Answer = "Czas oczekiwania na decyzję kredytową może się różnić w zależności od banku, kompletności dokumentów oraz aktualnego obciążenia instytucji finansowej. W wielu przypadkach wstępna decyzja pojawia się już po kilku dniach, natomiast ostateczna decyzja kredytowa zazwyczaj wydawana jest w ciągu około 2–4 tygodni. W trakcie całego procesu ekspert monitoruje postęp wniosku, kontaktuje się z bankiem oraz pomaga uzupełnić ewentualne brakujące dokumenty, aby maksymalnie przyspieszyć procedurę."
        },
        new
        {
            Question = "Jaki muszę uzbierać wkład własny, aby przysługiwał mi kredyt?",
            Answer = "Wkład własny to część wartości nieruchomości, którą finansujesz z własnych środków. Najczęściej banki wymagają minimum 10–20% wartości nieruchomości, jednak dokładna wysokość zależy od konkretnej oferty banku oraz Twojej sytuacji finansowej. Im wyższy wkład własny, tym często można liczyć na korzystniejsze warunki kredytu, takie jak niższa marża lub lepsza oferta finansowania. Podczas konsultacji ekspert dokładnie przeanalizuje Twoją sytuację i pomoże określić, jaki wkład własny będzie potrzebny oraz jakie masz możliwości uzyskania kredytu."
        }
    };
}

<section class="bg-[#f3f3f5]" aria-labelledby="financing-faq-heading">
    <div class="max-w-[1400px] mx-auto px-4 py-10 lg:py-20">
        <h2 id="financing-faq-heading" class="font-barlow font-semibold text-center text-[28px] lg:text-[44px] leading-[1.2] text-[#151515] mb-8 lg:mb-12">
            Często pojawiające się pytania
        </h2>

        <div class="financing-faq max-w-[1000px] mx-auto bg-white rounded-[24px] overflow-hidden divide-y divide-[#c2c0c9]">
            @foreach (var item in faqItems)
            {
                <details name="financing-faq" class="group">
                    <summary class="flex items-center justify-between gap-4 cursor-pointer list-none px-6 py-5 lg:px-8 lg:py-6 font-barlow font-semibold text-[18px] lg:text-[20px] leading-[1.3] text-[#151515] hover:bg-[#fafafa] transition-colors">
                        <span>@item.Question</span>
                        <span class="financing-faq__icon shrink-0 inline-flex items-center justify-center w-6 h-6 text-[#ba9e60]" aria-hidden="true">
                            <svg class="w-4 h-4 transition-transform duration-200" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </summary>
                    <div class="px-6 pb-5 lg:px-8 lg:pb-6">
                        <p class="font-inter text-[16px] lg:text-[18px] leading-[1.5] text-[#595355] m-0">
                            @item.Answer
                        </p>
                    </div>
                </details>
            }
        </div>
    </div>
</section>

<style>
    .financing-faq summary::-webkit-details-marker {
        display: none;
    }

    .financing-faq summary::marker {
        display: none;
    }
</style>
